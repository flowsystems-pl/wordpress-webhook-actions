#: admin/src/views/ExternalCronView.vue
msgid ""
"%1$s/wp-cron.php?doing_wp_cron%2$s — runs all WordPress scheduled tasks. "
"Min interval: 60s. %1$sDISABLE_WP_CRON%2$s is added to "
"%1$swp-config.php%2$s automatically."
msgstr ""
"%1$s/wp-cron.php?doing_wp_cron%2$s — voert alle geplande WordPress-taken "
"uit. Min. interval: 60s. %1$sDISABLE_WP_CRON%2$s wordt automatisch "
"toegevoegd aan %1$swp-config.php%2$s."

#: admin/src/views/ExternalCronView.vue
msgid ""
"%1$s/wp-json/fswa/v1/cron/process?token=…%2$s — processes only the webhook "
"queue. Min interval: 20s."
msgstr ""
"%1$s/wp-json/fswa/v1/cron/process?token=…%2$s — verwerkt alleen de "
"webhook-wachtrij. Min. interval: 20s."

#: admin/src/components/PayloadGlueDrawer.vue
msgid ""
"%1$sAvailable variables:%2$s %3$s$payload%4$s (mapped array), %3$s$args%4$s "
"(%5$s$payload['args']%6$s)"
msgstr ""
"%1$sBeschikbare variabelen:%2$s %3$s$payload%4$s (gemapte array), "
"%3$s$args%4$s (%5$s$payload['args']%6$s)"

#: admin/src/components/PayloadGlueDrawer.vue
msgid ""
"%1$sAvailable variables:%2$s %3$s$payload%4$s (sent), "
"%3$s$originalPayload%4$s (pre-mapping), %3$s$responseCode%4$s, "
"%3$s$responseBody%4$s"
msgstr ""
"%1$sBeschikbare variabelen:%2$s %3$s$payload%4$s (verzonden), "
"%3$s$originalPayload%4$s (vóór mapping), %3$s$responseCode%4$s, "
"%3$s$responseBody%4$s"

#: admin/src/views/ExternalCronView.vue
msgid "%1$sDISABLE_WP_CRON%2$s is active — WP-Cron auto-spawn is disabled."
msgstr ""
"%1$sDISABLE_WP_CRON%2$s is actief — automatisch starten van WP-Cron is "
"uitgeschakeld."

#: admin/src/views/ExternalCronView.vue
msgid "%1$sDISABLE_WP_CRON%2$s will be written to %1$swp-config.php%2$s on save."
msgstr ""
"%1$sDISABLE_WP_CRON%2$s wordt bij opslaan naar %1$swp-config.php%2$s "
"geschreven."

#: admin/src/views/VaultView.vue
msgid ""
"%1$sFSWA_SECRET_KEY%2$s is defined and your credentials still work, but a "
"copy of the old key remains in the database — so you don't yet get the full "
"benefit. Re-encrypt now to seal every secret with the wp-config key and "
"delete the database key."
msgstr ""
"%1$sFSWA_SECRET_KEY%2$s is gedefinieerd en je referenties werken nog "
"steeds, maar een kopie van de oude sleutel blijft in de database staan — je "
"profiteert dus nog niet volledig. Versleutel nu opnieuw om elk geheim met "
"de wp-config-sleutel te verzegelen en de databasesleutel te verwijderen."

#: admin/src/views/VaultView.vue
msgid ""
"%1$sFormat:%2$s any long, random, secret string (64+ characters "
"recommended). Generate one from the %3$sWordPress salt generator%4$s or "
"with %5$swp_generate_password(64, true, true)%6$s."
msgstr ""
"%1$sFormaat:%2$s een lange, willekeurige, geheime tekenreeks (64+ tekens "
"aanbevolen). Genereer er een met de %3$sWordPress salt-generator%4$s of met "
"%5$swp_generate_password(64, true, true)%6$s."

#: admin/src/views/VaultView.vue
msgid ""
"%1$sKeep it stable &amp; backed up:%2$s don't change or lose this value "
"once credentials are sealed with it, or they become unrecoverable."
msgstr ""
"%1$sHoud hem stabiel en maak een back-up:%2$s wijzig of verlies deze waarde "
"niet zodra referenties ermee zijn verzegeld, anders worden ze onherstelbaar."

#: admin/src/components/PayloadGlueDrawer.vue
msgid ""
"%1$sOrder:%2$s field mapping runs first, then this snippet — so "
"%3$s$payload%4$s here is the %5$spost-mapping%6$s payload, exactly as at "
"dispatch."
msgstr ""
"%1$sVolgorde:%2$s eerst draait de veldmapping, daarna dit snippet — dus "
"%3$s$payload%4$s is hier de payload %5$sná de mapping%6$s, precies zoals "
"bij verzending."

#: admin/src/views/ProView.vue
msgid "%1$sPriority support%2$s — Pro subscribers get a direct response via email."
msgstr ""
"%1$sPrioriteitsondersteuning%2$s — Pro-abonnees krijgen een rechtstreeks "
"antwoord via e-mail."

#: admin/src/views/VaultView.vue
msgid ""
"%1$sSafe to add anytime:%2$s existing credentials keep working immediately. "
"After adding it, return here and click the %3$sRe-encrypt%4$s button that "
"appears to finish the move and remove the database key."
msgstr ""
"%1$sAltijd veilig toe te voegen:%2$s bestaande referenties blijven direct "
"werken. Kom na het toevoegen hier terug en klik op de knop %3$sOpnieuw "
"versleutelen%4$s die verschijnt om de verplaatsing te voltooien en de "
"databasesleutel te verwijderen."

#: admin/src/components/PayloadGlueDrawer.vue
msgid ""
"%1$sShorthand:%2$s works for any variable, e.g. %3$s{{ $args.0.field }}%4$s "
"→ %3$s$args[0]['field']%4$s, %3$s{{ $payload.key }}%4$s → "
"%3$s$payload['key']%4$s"
msgstr ""
"%1$sVerkorte notatie:%2$s werkt voor elke variabele, bijv. %3$s{{ "
"$args.0.field }}%4$s → %3$s$args[0]['field']%4$s, %3$s{{ $payload.key "
"}}%4$s → %3$s$payload['key']%4$s"

#: admin/src/components/PayloadGlueDrawer.vue
msgid ""
"%1$sShorthand:%2$s works for any variable, e.g. %3$s{{ "
"$originalPayload.args.0.id }}%4$s → "
"%3$s$originalPayload['args'][0]['id']%4$s"
msgstr ""
"%1$sVerkorte notatie:%2$s werkt voor elke variabele, bijv. %3$s{{ "
"$originalPayload.args.0.id }}%4$s → "
"%3$s$originalPayload['args'][0]['id']%4$s"

#: admin/src/views/ExternalCronView.vue
msgid ""
"%1$swp-config.php%2$s is not writable. Add this line manually before the "
"“That’s all” comment: %3$sdefine( 'DISABLE_WP_CRON', true );%4$s"
msgstr ""
"%1$swp-config.php%2$s is niet beschrijfbaar. Voeg deze regel handmatig toe "
"vóór de opmerking “That’s all”: %3$sdefine( 'DISABLE_WP_CRON', true );%4$s"

